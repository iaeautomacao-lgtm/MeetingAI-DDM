# Flask
FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-segura

# Login diretores (dashboard executivo)
DIRECTOR_PASSWORD=
# Em produção (HTTPS) coloque 1
SESSION_COOKIE_SECURE=0

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_SCHEMA=meeting_ai

# Microsoft Azure / Entra (App Registration — permissões Application)
# OnlineMeetings.Read.All, OnlineMeetingTranscript.Read.All,
# CallRecords.Read.All, Mail.Read, User.Read.All
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:5000/auth/callback

# Azure Speech (fallback para upload manual de áudio)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# IA — preencha UMA. Prioridade: OpenAI > Gemini > Anthropic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Recall.ai (bot "DDM" entra na reunião, grava e transcreve)
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_BOT_NAME=Acordito
# URL pública p/ webhook (deploy ou ngrok). Configurar em recall.ai/dashboard/webhooks
# apontando para: <PUBLIC_BASE_URL>/api/recall/webhook
PUBLIC_BASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# IMAP (e-mail cPanel — contas fora do Microsoft 365)
IMAP_HOST=mail.ddm.adv.br
IMAP_PORT=993
IMAP_USER=usuario@ddm.adv.br
IMAP_PASSWORD=

# Config
TEAMS_DOMAIN=ddm.adv.br
CORP_DOMAINS=ddm.adv.br,grupoddm.com.br
SYNC_INTERVAL_MINUTES=5
